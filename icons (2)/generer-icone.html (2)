<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Générer l'icône FASO TEEDO</title>
    <style>
        body {
            font-family: sans-serif;
            text-align: center;
            padding: 2rem;
            background: #f5f0e8;
        }
        canvas {
            border: 2px solid #1a5632;
            border-radius: 16px;
            margin: 1rem;
        }
        .btn {
            background: #1a5632;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            margin: 0.5rem;
        }
        .btn:hover { background: #2d8a4e; }
        .tailles {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
            justify-content: center;
            margin-top: 1rem;
        }
        .taille-item {
            text-align: center;
        }
        .taille-item img {
            border: 1px solid #ccc;
            border-radius: 8px;
        }
    </style>
</head>
<body>
    <h1>🖼️ Générateur d'icônes FASO TEEDO</h1>
    <p>Cliquez sur chaque taille pour télécharger l'icône</p>
    
    <canvas id="canvas" width="512" height="512"></canvas>
    
    <div class="tailles" id="taillesContainer"></div>
    
    <br>
    <button class="btn" onclick="genererToutes()">📥 Télécharger toutes les tailles (ZIP non supporté, clic par clic)</button>
    
    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        
        // Dessiner l'icône
        function dessinerIcone(taille) {
            canvas.width = taille;
            canvas.height = taille;
            
            // Fond vert
            const gradient = ctx.createLinearGradient(0, 0, taille, taille);
            gradient.addColorStop(0, '#1a5632');
            gradient.addColorStop(1, '#2d8a4e');
            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.roundRect(0, 0, taille, taille, taille * 0.15);
            ctx.fill();
            
            // Texte FT
            ctx.fillStyle = '#d4a017';
            ctx.font = `bold ${taille * 0.4}px 'Georgia', serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('FT', taille / 2, taille * 0.45);
            
            // Ligne dorée
            ctx.strokeStyle = '#d4a017';
            ctx.lineWidth = taille * 0.02;
            ctx.beginPath();
            ctx.moveTo(taille * 0.2, taille * 0.65);
            ctx.lineTo(taille * 0.8, taille * 0.65);
            ctx.stroke();
            
            // Sous-texte
            ctx.fillStyle = 'white';
            ctx.font = `${taille * 0.1}px 'Segoe UI', sans-serif`;
            ctx.fillText('FASO TEEDO', taille / 2, taille * 0.8);
        }
        
        // Tailles nécessaires
        const tailles = [72, 96, 128, 144, 152, 192, 384, 512];
        
        function genererToutes() {
            const container = document.getElementById('taillesContainer');
            container.innerHTML = '';
            
            tailles.forEach(taille => {
                dessinerIcone(taille);
                
                const div = document.createElement('div');
                div.className = 'taille-item';
                
                const img = document.createElement('img');
                img.src = canvas.toDataURL('image/png');
                img.width = taille > 128 ? 128 : taille;
                img.height = taille > 128 ? 128 : taille;
                img.style.cursor = 'pointer';
                img.title = `Télécharger ${taille}x${taille}`;
                
                img.addEventListener('click', function() {
                    const link = document.createElement('a');
                    link.download = `icon-${taille}x${taille}.png`;
                    link.href = canvas.toDataURL('image/png');
                    link.click();
                });
                
                const label = document.createElement('p');
                label.textContent = `${taille}×${taille}`;
                label.style.fontSize = '12px';
                label.style.margin = '4px 0';
                
                div.appendChild(img);
                div.appendChild(label);
                container.appendChild(div);
            });
            
            // Revenir à 512 pour l'affichage
            dessinerIcone(512);
        }
        
        // Dessiner l'icône par défaut
        dessinerIcone(512);
        genererToutes();
        
        // Polyfill roundRect si nécessaire
        if (!ctx.roundRect) {
            ctx.roundRect = function(x, y, w, h, r) {
                if (typeof r === 'number') r = { tl: r, tr: r, br: r, bl: r };
                ctx.beginPath();
                ctx.moveTo(x + r.tl, y);
                ctx.lineTo(x + w - r.tr, y);
                ctx.quadraticCurveTo(x + w, y, x + w, y + r.tr);
                ctx.lineTo(x + w, y + h - r.br);
                ctx.quadraticCurveTo(x + w, y + h, x + w - r.br, y + h);
                ctx.lineTo(x + r.bl, y + h);
                ctx.quadraticCurveTo(x, y + h, x, y + h - r.bl);
                ctx.lineTo(x, y + r.tl);
                ctx.quadraticCurveTo(x, y, x + r.tl, y);
                ctx.closePath();
            };
        }
    </script>
</body>
</html>
